# MemTrace needs no API keys. Everything runs locally.
# Optional settings:

# Where Hugging Face caches models (gpt2 is ~500 MB).
# HF_HOME=~/.cache/huggingface

# Only needed for gated models (e.g. some Llama variants) on the GPU path.
# HF_TOKEN=

# Force fully-offline mode once gpt2 is cached.
# HF_HUB_OFFLINE=1

# CPU threads used by PyTorch. Do not run two trainings with all cores each.
# OMP_NUM_THREADS=8
